{
  "name": "@codelittinc/carbon-design-system",
  "version": "2.0.0",
  "description": "CarbonOS Design System — Refined Carbon. Shared React UI components and design tokens.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codelittinc/carbon-design-system.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "default": "./dist/utils.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "default": "./dist/tokens.js"
    },
    "./styles": "./src/styles/theme.css"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build": "storybook build && pnpm run build:auth",
    "build-storybook": "storybook build",
    "build:lib": "node scripts/generate-tokens.mjs && tsup",
    "tokens:generate": "node scripts/generate-tokens.mjs",
    "prepack": "pnpm run build:lib",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node server.js",
    "build:auth": "vite build --config auth/vite.config.ts",
    "test:auth": "node --test test/server-auth.node.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-table": "^9.3.1",
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-code-block": "^3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-link": "^3.35.0",
    "@tiptap/extension-list": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "docx-preview": "^0.4.1",
    "lucide-react": "^1.79.0",
    "papaparse": "^5.7.1",
    "recharts": "^3.11.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@clerk/express": "^2.1.97",
    "@clerk/react": "^6.19.5",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-themes": "^10.6.8",
    "@storybook/react": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/google.maps": "^3.67.0",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "express": "^5.3.0",
    "i18next": "^27.2.7",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "storybook": "^10.6.8",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.23.0"
}
